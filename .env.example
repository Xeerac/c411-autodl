# Copie ce fichier en ".env" et remplis-le. Ne partage jamais le fichier .env.

# --- c411 ---
C411_URL=https://c411.org
# Clé API créée sur https://c411.org/user/integrations avec le scope « Torznab/RSS (lecture) » uniquement
C411_API_KEY=
# Catégories Torznab : 7020 = eBooks, 7030 = Comics/Manga, 3030 = Livres audio
C411_CATEGORIES=7020,7030

# --- Filtres ---
# Nombre minimum de « complétés » sur c411
MIN_COMPLETED=1
# Nombre minimum de seeders (1 = au moins une source pour pouvoir télécharger)
MIN_SEEDERS=1
# Taille max par torrent : 500Mo, 2Go, 1.5Go... (0 = pas de limite)
TAILLE_MAX=0
# Mots à exclure du titre, séparés par des virgules (ex : xxx,sample)
EXCLUDE_WORDS=

# --- Cibler ce qui rapporte de l'upload ---
# Ignorer les torrents qui ont déjà plus de N seeders (0 = pas de limite).
# Un ebook avec 50 seeders ne te rapportera presque rien : 20 est un bon point de départ.
MAX_SEEDERS=0
# Ne prendre que les torrents avec au moins N leechers, c'est-à-dire demandés (0 = pas de minimum)
MIN_LEECHERS=0
# Ordre de traitement : interet = les plus demandés d'abord (leechers / seeders), recent = ordre de c411
TRI=interet

# --- Qualité ---
# Taille minimum d'un torrent : 100Ko, 1Mo... (0 = pas de minimum). Écarte les fichiers suspects.
TAILLE_MIN=0
# Formats acceptés, cherchés dans le titre (ex : epub,cbz,cbr). Vide = tous les formats.
FORMATS=
# Le titre doit contenir AU MOINS UN de ces mots (ex : fr,french,vf). Vide = pas d'obligation.
MOTS_REQUIS=
# Groupes de release à exclure : ce qui suit le dernier tiret du titre (ex : notag,unknown)
GROUPES_EXCLUS=
# Pour les utilisateurs avancés : expression régulière d'exclusion, sans tenir compte des majuscules
# (ex : \bscann?e?\b|\bocr\b pour écarter les scans)
REGEX_EXCLUSION=

# --- Limites ---
# Nombre max de torrents ajoutés par passage
MAX_PER_RUN=50
# Espace disque à garder libre sur la seedbox (Go)
MIN_FREE_GB=20
# Pages Torznab parcourues à chaque passage (100 résultats par page, 6 max : c411 plafonne à 600)
PAGES=2
# Mots-clés utilisés par --rattrapage pour dépasser le plafond de 600 résultats
RATTRAPAGE_MOTS=epub,pdf,cbz,cbr,mobi,azw3,mp3,m4b,FR,FRENCH,MULTI,NOTAG,Tome,T01
PAGE_SIZE=100
# Pause entre deux requêtes c411, en secondes (limite : 120 requêtes/min)
REQUEST_DELAY=1
# Mode continu : un passage toutes les N secondes (0 = un seul passage).
# 300 est un bon choix : c411 met son flux en cache 5 min, vérifier plus souvent ne sert à rien.
BOUCLE_SECONDES=0

# --- Ratio ---
# Ne télécharge que si le ratio reste STRICTEMENT supérieur à cette valeur, même après le
# téléchargement (0 = désactivé). Les torrents freeleech ne comptent pas.
MIN_RATIO=2.0
# Deuxième clé API c411, créée avec uniquement le scope « Profil (lecture) »
C411_PROFILE_API_KEY=

# --- Nettoyage des torrents supprimés de c411 ---
# true = retire de qBittorrent les torrents supprimés de c411 (retirés par leur uploader, etc.).
# Sécurité : il faut que les trackers c411 signalent la suppression ET que l'API c411 confirme (404).
NETTOYAGE_SUPPRIMES=false
# fichiers = retire le torrent et supprime ses fichiers (gardés s'ils servent à un autre torrent, ex : cross-seed)
# torrent  = retire le torrent, garde les fichiers
# pause    = met en pause et ajoute le tag « c411-supprime », sans rien supprimer
NETTOYAGE_ACTION=fichiers
# Tag des torrents gérés par le programme : seuls eux sont nettoyés, envoyés à cross-seed et comptés
# dans le bilan (par défaut : ceux ajoutés par c411-autodl)
NETTOYAGE_TAG=autodl
# Fréquence de la vérification, en minutes
NETTOYAGE_MINUTES=60

# --- Mode freeleech (optionnel, nécessite C411_PROFILE_API_KEY) ---
# true = quand un freeleech est actif sur ton compte (événement du site, fenêtre freeleech, freeleech
# personnel), le programme élargit sa recherche : ce que tu télécharges ne compte pas, ce que tu envoies compte.
FREELEECH_MODE=false
# Catégories ajoutées pendant le freeleech, en plus de C411_CATEGORIES (ex : 2030,5000 = films, séries)
FREELEECH_CATEGORIES=
# Nombre maximum de torrents ajoutés par passage pendant le freeleech
FREELEECH_MAX_PAR_PASSAGE=100
# Taille maximum pendant le freeleech (vide = même valeur que TAILLE_MAX). Ex : 30Go
FREELEECH_TAILLE_MAX=
# true = FORMATS est ignoré pendant le freeleech (sinon FORMATS=epub,cbz écarterait films et séries)
FREELEECH_IGNORER_FORMATS=true

# --- Alerte en cas de panne ---
# true = notification Discord/Telegram si le programme échoue plusieurs passages d'affilée
# (seedbox injoignable, clé expirée…), puis une autre quand tout repart
ALERTE_PANNE=true
# Nombre de passages en échec d'affilée avant l'alerte (3 passages = 15 min avec un passage toutes les 5 min)
ALERTE_APRES=3

# --- cross-seed (optionnel) ---
# Si cross-seed tourne sur la même machine : dès qu'un torrent ajouté par le programme a fini de
# télécharger, cross-seed est prévenu et cherche tout de suite la même release sur tes autres trackers.
# Laisse vide pour désactiver.
CROSS_SEED_URL=
# Clé de l'API cross-seed (commande : cross-seed api-key, ou avec Docker :
# docker compose exec cross-seed cross-seed api-key)
CROSS_SEED_API_KEY=

# --- Prowlarr (optionnel) ---
# Seulement pour afficher son état dans l'interface web. Laisse vide si tu n'utilises pas Prowlarr.
PROWLARR_URL=
# Dans Prowlarr : Settings > General > API Key
PROWLARR_API_KEY=

# --- Bilan quotidien (optionnel) ---
# true = un bilan chaque jour (journal + Discord/Telegram) : torrents ajoutés, volume téléchargé et envoyé,
# évolution du ratio, rendement par type de contenu
BILAN_QUOTIDIEN=false
# Heure d'envoi du bilan (0 à 23)
BILAN_HEURE=8

# --- Notifications (optionnel : laisse vide pour désactiver) ---
# Discord : Paramètres du salon > Intégrations > Webhooks > Nouveau webhook > Copier l'URL
DISCORD_WEBHOOK_URL=
# Telegram : crée un bot avec @BotFather (il donne le token), puis envoie-lui un message
# et récupère ton chat_id avec @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Prévenir aussi quand le script se met en pause ou reprend à cause du ratio
NOTIF_PAUSES=true

# --- qBittorrent (WebUI de la seedbox) ---
# Adresse de la WebUI telle que donnée par seedhost (sans /api/v2 à la fin)
QBIT_URL=https://exemple.seedhost.eu/utilisateur/qbittorrent
QBIT_USER=
QBIT_PASS=
QBIT_CATEGORY=c411-ebook
# true = une catégorie qBittorrent par type de contenu : c411-ebook, c411-bd, c411-presse,
# c411-livre-audio, c411-film… (QBIT_CATEGORY n'est alors plus utilisé)
QBIT_CATEGORIE_PAR_TYPE=false
# Début du nom de ces catégories
QBIT_CATEGORIE_PREFIXE=c411
QBIT_TAGS=c411,autodl
# Dossier de destination (vide = dossier par défaut de qBittorrent)
QBIT_SAVEPATH=
# true = ajoute les torrents en pause
QBIT_PAUSED=false
